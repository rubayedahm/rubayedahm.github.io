---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, postUrl, type Post } from '../../utils/posts';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  // posts are newest first: "newer" is the previous item, "older" the next
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const url = new URL(postUrl(post), Astro.site).href;
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  x: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.data.title)}`,
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  url,
};
---

<Base title={`${post.data.title} — ${site.name}`} description={post.data.description} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />
  <main id="top" class="wrap post-page">
    <article class="post">
      <a class="back-link mono reveal" href="/blog/">← All posts</a>
      <header class="post-header">
        <div class="post-tags reveal">
          {post.data.tags.map((t) => <span class="pill mono">{t}</span>)}
        </div>
        <h1 class="post-title reveal">{post.data.title}</h1>
        <p class="lead reveal">{post.data.description}</p>
        <div class="byline reveal">
          <span class="byline-name">{site.name}</span>
          <span class="byline-meta mono muted">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post.body)}</span>
            {post.data.updated && <span>· Updated {formatDate(post.data.updated)}</span>}
          </span>
        </div>
      </header>

      {
        post.data.cover && (
          <Image
            class="post-cover reveal"
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            widths={[720, 1080, 1440]}
            sizes="(max-width: 760px) 100vw, 720px"
          />
        )
      }

      <div class="prose reveal">
        <Content />
      </div>

      <footer class="post-share">
        <p class="mono muted">Share this post</p>
        <div class="share-buttons">
          <button class="btn ghost" id="copy-link" data-url={url}>Copy link</button>
          <a class="btn ghost" href={share.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn ghost" href={share.x} target="_blank" rel="noopener">X ↗</a>
        </div>
      </footer>
    </article>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a class="tile post-nav-link" href={postUrl(older)}>
              <span class="mono muted">← Older</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="tile post-nav-link next" href={postUrl(newer)}>
              <span class="mono muted">Newer →</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</Base>

<script>
  import { $, copyText } from '../../scripts/dom';

  const btn = $<HTMLButtonElement>('#copy-link');
  btn.addEventListener('click', () => copyText(btn.dataset.url ?? location.href, 'Link copied ✓'));
</script>
