---
import { formatDate, readingTime, postUrl, type Post } from '../utils/posts';

interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;
---

<article class="tile post-card tilt reveal" style={`--i:${index}`} data-tags={post.data.tags.join('|')}>
  <a href={postUrl(post)} class="post-link">
    <div class="post-meta mono muted">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)}</span>
    </div>
    <h3>{post.data.title}</h3>
    <p class="muted">{post.data.description}</p>
    <div class="post-foot">
      <div class="post-tags">
        {post.data.tags.map((t) => <span class="pill mono">{t}</span>)}
      </div>
      <span class="read-more" aria-hidden="true">Read →</span>
    </div>
  </a>
</article>
