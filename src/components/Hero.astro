---
import { Picture } from 'astro:assets';
import { site } from '../data/site';

const school = site.education[0]?.school;
---

<section class="hero wrap">
  <div class="hero-text">
    <p class="status reveal"><span class="dot"></span>{site.status}</p>
    <h1 class="reveal">
      Hi, I'm {site.firstName}.<br />
      I'm a <span class="typed grad-text" aria-live="polite" data-roles={JSON.stringify(site.roles)}
        >{site.roles[0]}</span
      ><span class="caret" aria-hidden="true"></span>
    </h1>
    <p class="lead reveal">{site.intro}</p>
    <div class="actions reveal">
      <a class="btn" href="#contact">Get in touch <span aria-hidden="true">→</span></a>
      {site.cv && <a class="btn ghost" href={site.cv} download>Download CV</a>}
      <a class="btn ghost" href="#experience">View experience</a>
    </div>
  </div>

  <figure class="photo reveal">
    <div class="photo-glow" aria-hidden="true"></div>
    <div class="photo-frame tilt">
      <Picture
        src={site.photo}
        alt={`Portrait of ${site.name}`}
        formats={['avif', 'webp']}
        widths={[320, 480, 680]}
        sizes="(max-width: 560px) 240px, (max-width: 880px) 280px, 360px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    {
      school && (
        <figcaption class="chip chip-a">
          <span class="chip-icon">🎓</span>
          {school}
        </figcaption>
      )
    }
    <div class="chip chip-b"><span class="chip-icon">📍</span>{site.location}</div>
  </figure>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {
      [0, 1].map(() =>
        Object.values(site.skills)
          .flat()
          .slice(0, 10)
          .map((w) => (
            <>
              <span>{w}</span>
              <span class="star">✦</span>
            </>
          )),
      )
    }
  </div>
</div>

<script>
  import { $, reduceMotion } from '../scripts/dom';

  // Typewriter effect cycling through roles
  const typed = $('.typed');
  const roles: string[] = JSON.parse(typed.dataset.roles ?? '[]');

  if (!reduceMotion && roles.length > 1) {
    let r = 0;
    let c = roles[0].length;
    let deleting = true;
    const tick = () => {
      const word = roles[r];
      c += deleting ? -1 : 1;
      typed.textContent = word.slice(0, c);
      let delay = deleting ? 35 : 70;
      if (!deleting && c === word.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && c === 0) {
        deleting = false;
        r = (r + 1) % roles.length;
        delay = 300;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 2000);
  }
</script>
