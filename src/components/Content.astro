---
import Section from './Section.astro';
import { site } from '../data/site';

const skillIcons: Record<string, string> = {
  'Leadership & people': '🧭',
  Business: '📈',
  Tools: '🛠️',
};
---

<Section id="about" index={1} title="About" heading="A little <span class='grad-text'>about me</span>">
  <div class="bento">
    <article class="tile tile-about tilt reveal">
      {site.about.map((p) => <p>{p}</p>)}
    </article>
    {
      site.facts.map((f, i) => (
        <article class="tile tile-fact tilt reveal" style={`--i:${i}`}>
          <p class="fact-label mono">{f.label}</p>
          <p class="fact-value">{f.value}</p>
        </article>
      ))
    }
  </div>
</Section>

<Section id="experience" index={2} title="Experience" heading="Where I've <span class='grad-text'>worked</span>">
  <ol class="timeline">
    {
      site.experience.map((x, i) => (
        <li class="tl-item reveal" style={`--i:${i}`}>
          <span class="tl-dot" aria-hidden="true" />
          <article class="tile tl-card tilt">
            <div class="tl-top">
              <h3>{x.role}</h3>
              <span class="pill mono">
                {x.start} — {x.end}
              </span>
            </div>
            <p class="tl-org">
              {x.org}
              {(x.type || x.location) && <span class="muted">{[x.type, x.location].filter(Boolean).join(' · ')}</span>}
            </p>
            {x.points && x.points.length > 0 && (
              <ul>
                {x.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</Section>

<Section id="education" index={3} title="Education" heading="What I'm <span class='grad-text'>learning</span>">
  <div class="grid-2">
    {
      site.education.map((e, i) => (
        <article class="tile edu-card tilt reveal" style={`--i:${i}`}>
          <div class="edu-icon" aria-hidden="true">
            {i === 0 ? '🎓' : '📚'}
          </div>
          <span class="pill mono">
            {e.start} — {e.end}
          </span>
          <h3>{e.degree}</h3>
          <p class="edu-school">{e.school}</p>
          {e.location && <p class="edu-location mono muted">📍 {e.location}</p>}
          {e.details && <p class="muted">{e.details}</p>}
        </article>
      ))
    }
  </div>
</Section>

<Section id="skills" index={4} title="Skills" heading="What I <span class='grad-text'>bring</span>">
  <div class="grid-3">
    {
      Object.entries(site.skills).map(([group, items], i) => (
        <article class="tile skill-card tilt reveal" style={`--i:${i}`}>
          <div class="skill-head">
            <span class="skill-icon" aria-hidden="true">
              {skillIcons[group] ?? '✦'}
            </span>
            <h3>{group}</h3>
          </div>
          <ul class="chips">
            {items.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

{
  site.highlights.length > 0 && (
    <Section id="highlights" index={5} title="Highlights" heading="Things I'm <span class='grad-text'>proud of</span>">
      <div class="grid-3">
        {site.highlights.map((h, i) => (
          <article class="tile card tilt reveal" style={`--i:${i}`}>
            <div class="card-top">
              <span class="pill mono">{h.tag}</span>
              <span class="card-num mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{h.title}</h3>
            <p class="muted">{h.text}</p>
          </article>
        ))}
      </div>
    </Section>
  )
}
