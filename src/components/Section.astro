---
interface Props {
  id: string;
  index: number;
  title: string;
  heading: string;
}
const { id, index, title, heading } = Astro.props;
---

<section id={id} class="section wrap">
  <header class="section-head reveal">
    <p class="eyebrow mono"><span>{String(index).padStart(2, '0')}</span>{title}</p>
    <h2 class="section-title" set:html={heading} />
  </header>
  <slot />
</section>
