---
const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
interface Props {
  name: string;
}
const { name } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="logo"><span class="logo-mark" aria-hidden="true">{initials}</span><span class="logo-name">{name}</span></a>
    <nav class="links" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav-tools">
      <button class="kbd-btn" id="open-palette" aria-label="Open quick menu">
        <span class="mono">⌘K</span>
      </button>
      <button class="icon-btn" id="theme" aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            ><path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></g
          ></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path></svg
        >
      </button>
      <button class="icon-btn menu-btn" id="menu" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" hidden>
  <nav aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</div>

<script>
  import { $, $$, reduceMotion } from '../scripts/dom';

  const root = document.documentElement;

  // Theme toggle with a circular reveal (View Transitions API)
  const isDark = (): boolean =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;

  function toggleTheme(x?: number, y?: number): void {
    const apply = () => {
      root.dataset.theme = isDark() ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
    };
    if (!document.startViewTransition || reduceMotion) return apply();
    root.style.setProperty('--vt-x', `${x ?? innerWidth / 2}px`);
    root.style.setProperty('--vt-y', `${y ?? 0}px`);
    document.startViewTransition(apply);
  }
  $<HTMLButtonElement>('#theme').addEventListener('click', (e) => toggleTheme(e.clientX, e.clientY));
  window.addEventListener('toggle-theme', () => toggleTheme());

  // Header border once scrolled
  const header = $('.nav');
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Highlight the nav link for the section in view
  const navLinks = $$<HTMLAnchorElement>('.links a');
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        navLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${en.target.id}`));
      }),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  $$('main section[id]').forEach((s) => spy.observe(s));

  // Mobile menu
  const drawer = $('#drawer');
  const menuBtn = $('#menu');
  const setMenu = (open: boolean) => {
    drawer.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('menu-open', open);
  };
  menuBtn.addEventListener('click', () => setMenu(drawer.hasAttribute('hidden')));
  drawer.addEventListener('click', (e) => (e.target as Element).closest('a') && setMenu(false));
  addEventListener('keydown', (e) => e.key === 'Escape' && !drawer.hasAttribute('hidden') && setMenu(false));
</script>
